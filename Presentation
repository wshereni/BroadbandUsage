library(tidyverse)
data <- read_csv("../data/broadband_data_zipcode.csv")

cleaned_data <- data %>%
  filter((ST == "CA" & `COUNTY NAME` == "Los Angeles") |
         (ST == "NY" & `COUNTY NAME` %in% c("Bronx", "Kings", "New York", "Queens", "Richmond"))) %>%
  mutate(Location = ifelse(ST == "CA", "Los Angeles", "New York City")) %>%
  select(Location, `BROADBAND USAGE`, `ERROR RANGE (MAE)(+/-)`) %>%
